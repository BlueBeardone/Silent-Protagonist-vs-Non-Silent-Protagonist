MONGODB_URI=mongodb://localhost:27017/community_comments
ADMIN_TOKEN=
ALLOWED_ORIGIN=http://localhost:4200
TRUSTED_PROXY_HOPS=0
PORT=8080

# Optional. Set to a Cloudflare Turnstile secret to require a CAPTCHA token on
# POST /api/comments. Leave empty to use the honeypot only.
TURNSTILE_SECRET_KEY=

# Optional. Base64-encoded 32-byte AES key. When set, emails are encrypted at
# rest. Generate one with:
#   openssl rand -base64 32
EMAIL_ENCRYPTION_KEY=

# Optional. Overrides the default Content-Security-Policy. When empty, the
# server uses a policy that works with the default Flutter web build.
CSP=

# Optional. If the app is served from a different origin than the API (for
# example Netlify + Render), set this to the API origin so the CSP allows it.
API_ORIGIN=

# Optional. How long comments are kept. The server does not delete
# automatically; this is documentation for the operator's cleanup job.
RETENTION_DAYS=365
