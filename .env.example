# This file is documentation only: nothing loads a .env file. Export these
# variables into the server's environment before running it, e.g.
#   export MONGODB_URI=... ADMIN_TOKEN=... && dart run bin/server.dart
# Never commit real secrets.
# MongoDB connection string (required). The server exits if this is empty.
MONGODB_URI=mongodb://localhost:27017/community_comments
# Shared secret required by DELETE /api/comments/<id> via the x-admin-token header.
ADMIN_TOKEN=change-me
# Origin allowed to call the comments API from the browser. Leave empty in
# production (same-origin). Set e.g. http://localhost:3000 for local dev.
ALLOWED_ORIGIN=
# Number of trusted reverse proxies in front of the server (0 = trust none).
TRUSTED_PROXY_HOPS=0
# Port the HTTP server binds to.
PORT=8080
