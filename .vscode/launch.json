{
  // Run the app and/or the local proxy from VS Code (Run and Debug / F5).
  // Install the "Dart" and "Flutter" extensions first.
  "version": "0.2.0",
  "configurations": [
    {
      // The Flutter web app. Needs the proxy running to load numbers and
      // comments. The web port is pinned so the proxy's ALLOWED_ORIGIN
      // (http://localhost:4200) matches; API_BASE_URL points comments at the
      // proxy instead of the Flutter dev server.
      "name": "App (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--web-port=4200",
        "--dart-define=API_BASE_URL=http://localhost:8080"
      ]
    },
    {
      // The local proxy that serves /api/stats on port 8080.
      "name": "Proxy (port 8080)",
      "request": "launch",
      "type": "dart",
      "program": "bin/server.dart"
    }
  ],
  "compounds": [
    {
      // Starts the proxy first, then the app. Use the app's Refresh button if
      // the first load beats the proxy to the port.
      "name": "App + Proxy",
      "configurations": ["Proxy (port 8080)", "App (Chrome)"],
      "stopAll": true
    }
  ]
}
